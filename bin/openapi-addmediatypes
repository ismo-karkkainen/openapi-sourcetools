require_relative '../lib/openapi/sourcetools/apiobjects'
require_relative '../lib/openapi/sourcetools/common'
require 'optparse'
require 'yaml'


def main
  input_name = nil
  output_name = nil
  path = %w[components mediaTypes]
  components = OpenAPISourceTools::ApiObjects::Components.new(path, 'MediaType')
  replacer = OpenAPISourceTools::ApiObjects::ValueSubValueReplacer.new('content', components)

  parser = OptionParser.new do |opts|
    opts.summary_indent = '  '
    opts.summary_width = 26
    opts.banner = 'Usage: openapi-addmediatypes [options]'
    opts.separator ''
    opts.separator 'Options:'
    opts.on('-i', '--input FILE', 'Read API spec from FILE, not stdin.') do |f|
      input_name = f
    end
    opts.on('-o', '--output FILE', 'Output to FILE, not stdout.') do |f|
      output_name = f
    end
    components.add_options(opts)
    opts.on('-h', '--help', 'Print this help and exit.') do
      $stdout.puts %(#{opts}

Loads API document in OpenAPI format and moves media types under components
and replaces the original with reference.

#{components.help}
)
      exit 0
    end
  end
  parser.order!

  doc = OpenAPISourceTools::Common.load_source(input_name)
  return 2 if doc.nil?

  components.items = doc.dig(*path) || {}
  replacer.replace(doc.dig('components', 'headers') || {})
  replacer.replace(doc.dig('components', 'responses') || {})
  replacer.replace(doc.dig('components', 'parameters') || {})
  replacer.replace(doc.fetch('paths', {}))
  OpenAPISourceTools::Common.bury(doc, path, components.items) unless components.items.empty?

  OpenAPISourceTools::Common.dump_result(output_name, doc, 3)
end

exit(main) if File.basename(__FILE__) == File.basename($PROGRAM_NAME)
