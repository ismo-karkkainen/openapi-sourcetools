openapi: 3.1.0
info:
  title: SomeAPI
  version: 1.0.0
  description: 'Test API doc.

    '
  license:
    name: UPL
    url: https://opensource.org/license/upl
tags:
- name: action
  description: Action taken.
- name: health
  description: Health checks.
servers: []
paths:
  "/act":
    post:
      tags:
      - action
      summary: Action summary
      description: Action description.
      operationId: postAction
      requestBody:
        "$ref": "#/components/requestBodies/RequestBody0x"
      responses:
        '204':
          "$ref": "#/components/responses/Response0x"
        '403':
          "$ref": "#/components/responses/Response1x"
        '404':
          "$ref": "#/components/responses/Response2x"
        '500':
          "$ref": "#/components/responses/Response2x"
      parameters: []
  "/health":
    get:
      tags:
      - health
      summary: Health check
      description: Health check description.
      operationId: healthCheck
      responses:
        '204':
          "$ref": "#/components/responses/Response0x"
        '403':
          "$ref": "#/components/responses/Response1x"
        '404':
          "$ref": "#/components/responses/Response2x"
        '405':
          "$ref": "#/components/responses/Response1x"
        '500':
          "$ref": "#/components/responses/Response2x"
      parameters: []
components:
  schemas:
    Schema0x:
      description: Another description.
      type: string
      pattern: ".+"
      minLength: 1
      maxLength: 32768
    Schema1x:
      description: Field description.
      type: string
      pattern: "^(?:[A-Za-z\\d+/]{4})+(?:[A-Za-z\\d+/]{3}=|[A-Za-z\\d+/]{2}==)?$"
      minLength: 32
      maxLength: 1024
    Schema2x:
      description: Request body description.
      type: object
      required:
      - field
      properties:
        field:
          "$ref": "#/components/schemas/Schema1x"
        another:
          "$ref": "#/components/schemas/Schema0x"
    Schema3x:
      description: Whatever is deemed appropriate, if anything.
      type: object
    Schema4x:
      type: string
  mediaTypes:
    MediaType0x:
      examples: []
      schema:
        "$ref": "#/components/schemas/Schema2x"
    MediaType1x:
      schema:
        "$ref": "#/components/schemas/Schema3x"
  requestBodies:
    RequestBody0x:
      description: Blah blah
      content:
        application/json:
          "$ref": "#/components/mediaTypes/MediaType0x"
      required: true
  headers:
    Header0x:
      description: Description of the header.
      schema:
        "$ref": "#/components/schemas/Schema4x"
      examples: []
  responses:
    Response0x:
      description: Empty reply when payload ok.
    Response1x:
      description: Error response with an error object, possibly empty.
      headers:
        headername:
          "$ref": "#/components/headers/Header0x"
      content:
        application/json:
          "$ref": "#/components/mediaTypes/MediaType1x"
    Response2x:
      description: Error response with an error object, possibly empty.
      content:
        application/json:
          "$ref": "#/components/mediaTypes/MediaType1x"
