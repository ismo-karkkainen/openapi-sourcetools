class OpenApiLogicSplitTest < Test::Unit::TestCase
  def test_mixture
    # Case 1: Mixture of logic and other
    schema1 = { 'allOf' => {}, 'type' => 'string' }
    assert_equal(true, mixture?(schema1), 'Mixture of logic and other')

    # Case 2: Only logic
    schema2 = { 'allOf' => {}, 'anyOf' => {} }
    assert_equal(false, mixture?(schema2), 'Only logic')

    # Case 3: Only other
    schema3 = { 'type' => 'string', 'description' => 'foo' }
    assert_equal(false, mixture?(schema3), 'Only other')

    # Case 4: Empty
    schema4 = {}
    assert_equal(false, mixture?(schema4), 'Empty')

    # Case 5: Mixture but different order
    schema5 = { 'type' => 'string', 'allOf' => {} }
    assert_equal(true, mixture?(schema5), 'Mixture of other and logic')
  end

  def test_split
    name = 'MySchema'
    schema = { 'type' => 'string', 'allOf' => {}, 'description' => 'foo' }
    added_schemas = {}
    schema_path = '#/components/schemas'

    split(name, schema, added_schemas, schema_path)

    assert_equal(2, added_schemas.size, 'Added two schemas')
    assert_equal({ 'allOf' => {} }, added_schemas['MySchemaLogic'], 'Logic schema')
    assert_equal({ 'type' => 'string', 'description' => 'foo' }, added_schemas['MySchemaOther'], 'Other schema')
    assert_equal({ 'allOf' => [
      { '$ref' => "#{schema_path}/MySchemaLogic" },
      { '$ref' => "#{schema_path}/MySchemaOther" }
    ] }, schema, 'Original schema replaced by allOf')
  end
end
