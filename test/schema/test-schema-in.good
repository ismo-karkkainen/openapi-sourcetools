      type: object
      description: From schema.json
      properties:
        user:
          "$ref": "#/components/schemas/User"
        address:
          "$ref": "#/components/schemas/Address"
    Address:
      type: object
      description: From schema.json
      properties:
        street:
          type: string
        city:
          type: string
