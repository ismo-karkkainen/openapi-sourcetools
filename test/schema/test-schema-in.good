"$schema": https://json-schema.org/draft/2020-12/schema
type: object
description: From openapi.yaml
properties:
  user:
    "$ref": "#/$defs/User"
  number:
    type: number
"$defs":
  User:
    type: object
    description: From schema.json
    properties:
      id:
        type: integer
      name:
        type: string
  Address:
    type: object
    description: From schema.json
    properties:
