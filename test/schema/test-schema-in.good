openapi: 3.0.0
info:
  title: Test API
  version: 1.0.0
components:
  schemas:
    UserNumber:
      type: object
      description: From openapi.yaml
      properties:
        user:
          "$ref": "#/components/schemas/User"
        number:
          type: number
    User:
      type: object
      description: From schema.json
      properties:
        id:
          type: integer
        name:
          type: string
    Something:
      type: object
      description: From openapi.yaml
      properties:
