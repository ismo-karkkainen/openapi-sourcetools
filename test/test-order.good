####COMMAND Output default order
####CODE 0
####OUT
---
openapi-order-metadata:
  key: "x-order"
  regexp: "re:"
# Generic orders for any location of a key.
'**':
  servers:
    x-order: &ServerObject_order
    - url
    - name
    - description
    - variables
    '*':
      x-order: &ServerObject
      - name
      - description
      variables:
        x-order:
        - '*'
        '*':
          x-order: &ServerVariableObject
          - description
          - enum
          - default
  server: *ServerObject
  parameters:
    x-order: &ParameterObject_order
    - name
    - in
    '*': &ParameterObject
      x-order:
      - '$ref'
      - name
      - in
      - required
      - deprecated
      - description
      - content
      - schema
      - '*'
      - re:^example[s]?$
  schema: &Schema
    x-order:
    - '$ref'
    - title
    - description
    - deprecated
    - type
    - format
    - enum
    - const
    - default
    - readOnly
    - writeOnly
    # Numeric types.
    - minimum
    - exclusiveMinimum
    - exclusiveMaximum
    - maximum
    - multipleOf
####ERR
####COMMAND Help
####CODE 0
####OUT
Usage: openapi-order [options]

Options:
  -i, --input FILE     Read API spec from FILE, not stdin.
  -o, --output FILE    Output to FILE, not stdout.
####ERR
