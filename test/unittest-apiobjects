      'in' => 'query',
      'name' => 'apiq'
    }
    ss2 = ApiObjects::SecurityScheme.new('akq', akq)
    h = {
      'type' => 'http',
      'scheme' => 'Bearer'
    }
    ss3 = ApiObjects::SecurityScheme.new('http', h)
    schemes = {
      'akh' => ss1,
      'akq' => ss2,
      'http' => ss3
    }
    sro1 = ApiObjects::SecurityRequirementObject.new({ 'akh' => [] }, schemes)
    s = %w[scope scope2]
    sro6 = ApiObjects::SecurityRequirementObject.new({ 'akq' => [], 'http' => s }, schemes)
    sa1 = ApiObjects::SecurityAlternatives.new([sro1], schemes)
    sa2 = ApiObjects::SecurityAlternatives.new([sro6], schemes)
    sa3 = ApiObjects::SecurityAlternatives.new([sro1], schemes)
    assert_equal(sa1 <=> sa2, -1, 'smaller first')
    assert_equal(sa1 <=> sa3, 0, 'equal')
  end

  def test_value_retainer
    ret = ApiObjects::ValueRetainer.new('trigger')
    doc = YAML.safe_load(%(---
top:
  parent:
    trigger:
      key: value
      key2: value2
    deleted: value
  something:
    trigger: value
    erased:
    - key: value
      key2: value2
  multi:
    trigger: 5
    other:
      trigger: gone
      key: absent
  in_array:
  - key: value
    other: remains
  - trigger: remains
    other: removed
  - deeper:
      deleted: key
      trigger: value
  same:
    other: value
))
    ret.process(doc)
    expected = YAML.safe_load(%(---
top:
  parent:
    trigger:
      key: value
      key2: value2
  something:
    trigger: value
  multi:
    trigger: 5
  in_array:
  - key: value
    other: remains
  - trigger: remains
  - deeper:
      trigger: value
  same:
    other: value
))
    assert_equal(ApiObjects.same(doc, expected), true, 'triggers remain')
  end

  def test_value_replacer
    path = 'testing'
    prefix = 'Prefix'
    cmp = ApiObjects::Components.new(path, prefix)
    rep = ApiObjects::ValueReplacer.new('trigger', cmp)
    doc = YAML.safe_load(%(---
top:
  indifferent:
    trigger:
      key: value
      key2: value2
  something:
    trigger:
    - key: value
      key2: value2
    - other: value
    - '$ref': "testing/Prefix0x"
testing:
  Prefix0x:
    key: value
    key2: value2
))
    cmp.items = doc['testing']
    rep.replace(doc['top'])
    assert_equal(doc.dig('top', 'indifferent', 'trigger', '$ref'), 'testing/Prefix0x', 'replaced hash')
    assert_equal(doc.dig('top', 'something', 'trigger').first['$ref'], 'testing/Prefix0x', 'replaced in array')
    assert_equal(doc.dig('top', 'something', 'trigger')[1]['$ref'], 'testing/Prefix1x', 'replaced 2nd in array')
    assert_equal(doc.dig('top', 'something', 'trigger')[2]['$ref'], 'testing/Prefix0x', 'kept 3rd in array')
    assert_equal(cmp.items.size, 2, 'added one item')
  end

  def test_value_sub_value_replacer
    path = 'testing'
    prefix = 'Prefix'
    cmp = ApiObjects::Components.new(path, prefix)
    rep = ApiObjects::ValueSubValueReplacer.new('trigger', cmp)
    doc = YAML.safe_load(%(---
top:
  indifferent:
    trigger:
      something:
        replaced: value1
      else:
        key: value
      key: value
  something:
    arrayvalue:
    - key: value
      key2: value2
    - other: value
    - trigger:
        key: value
        object:
          replaced: value1
    - trigger:
        middle:
          '$ref': "testing/Prefix0x"
testing:
  Prefix0x:
    key: value
))
    cmp.items = doc['testing']
    rep.replace(doc['top'])
    assert_equal(doc.dig('top', 'indifferent', 'trigger', 'something', '$ref'), 'testing/Prefix1x', 'replaced hash')
    assert_equal(doc.dig('top', 'indifferent', 'trigger', 'else', '$ref'), 'testing/Prefix0x', 'replaced hash')
    assert_equal(doc.dig('top', 'indifferent', 'trigger', 'key'), 'value', 'non-hash kept')
    assert_equal(doc.dig('top', 'something', 'arrayvalue')[0]['key2'], 'value2', 'non-hash not replaced in array')
    assert_equal(doc.dig('top', 'something', 'arrayvalue')[1]['other'], 'value', 'non-hash not replaced in array')
    assert_equal(doc.dig('top', 'something', 'arrayvalue')[2].dig('trigger', 'key'), 'value', 'non-hash not replaced in array')
    assert_equal(doc.dig('top', 'something', 'arrayvalue')[2].dig('trigger', 'object', '$ref'), 'testing/Prefix1x', 'replaced in array')
    assert_equal(doc.dig('top', 'something', 'arrayvalue')[3].dig('trigger', 'middle', '$ref'), 'testing/Prefix0x', 'kept ref in array')
    assert_equal(cmp.items.size, 2, 'added 1')
  end
