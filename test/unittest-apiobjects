  def test_security_requirement_object
    akh = {
      'type' => 'apiKey',
      'in' => 'header',
      'name' => 'apih'
    }
    akq = {
      'type' => 'apiKey',
      'in' => 'query',
      'name' => 'apiq'
    }
    ss1 = ApiObjects::SecurityScheme.new('akh', akh)
    ss2 = ApiObjects::SecurityScheme.new('akq', akq)
    h = {
      'type' => 'http',
      'scheme' => 'Bearer'
    }
    ss3 = ApiObjects::SecurityScheme.new('http', h)
    oa = {
      'type' => 'oauth2',
      'flows' => {
        'implicit' => {
          'authorizationUrl' => 'https://www.skjfhaksfjdhf.com/oauth/authorize'
        },
        'password' => {
          'tokenUrl' => 'https://www.skjfhaksfjdhf.com/oauth/token',
          'scopes' => {}
        },
        'clientCredentials' => {
          'tokenUrl' => 'https://www.skjfhaksfjdhf.com/oauth/token'
        },
        'authorizationCode' => {
          'authorizationUrl' => 'https://www.skjfhaksfjdhf.com/oauth/authorize',
          'tokenUrl' => 'https://www.skjfhaksfjdhf.com/oauth/token'
        }
      }
    }
    ss4 = ApiObjects::SecurityScheme.new('oauth2', oa)
    oidc = {
      'type' => 'openIdConnect',
      'openIdConnectUrl' => 'https://www.skjfhaksfjdhf.com/.well-known/openid-configuration'
    }
    ss5 = ApiObjects::SecurityScheme.new('oidc', oidc)
    schemes = {
      'akh' => ss1,
      'akq' => ss2,
      'http' => ss3,
      'oauth2' => ss4,
      'oidc' => ss5
    }
    sro1 = ApiObjects::SecurityRequirementObject.new({ 'akh' => [] }, schemes)
    assert_equal(sro1.extras[:headers], { akh['name'] => [] }, 'Header parameter')
    assert_equal(sro1.extras.key?(:query), false, 'no query')
    sro2 = ApiObjects::SecurityRequirementObject.new({ 'akq' => [] }, schemes)
    assert_equal(sro2.extras[:query], { akq['name'] => [] }, 'query parameter')
    assert_equal(sro2.extras.key?(:headers), false, 'no headers')
    sro3 = ApiObjects::SecurityRequirementObject.new({ 'http' => [] }, schemes)
    assert_equal(sro3.extras[:headers], { 'authorization' => [] }, 'http authorization')
    assert_equal(sro3.extras.key?(:query), false, 'no query')
    sro4 = ApiObjects::SecurityRequirementObject.new({ 'oauth2' => [ 'scope' ] }, schemes)
    assert_equal(sro4.extras[:headers], { 'authorization' => [ 'scope' ] }, 'oauth2 authorization')
    assert_equal(sro4.extras.key?(:query), false, 'no query')
    s = %w[scope scope2]
    sro5 = ApiObjects::SecurityRequirementObject.new({ 'oidc' => s }, schemes)
    assert_equal(sro5.extras[:headers], { 'authorization' => s }, 'oidc authorization')
    assert_equal(sro5.extras.key?(:query), false, 'no query')
    sro6 = ApiObjects::SecurityRequirementObject.new({ 'akq' => [], 'http' => s }, schemes)
    assert_equal(sro6.extras[:query], { akq['name'] => [] }, 'query parameter too')
    assert_equal(sro6.extras[:headers], { 'authorization' => s }, 'http authorization too')
  end

