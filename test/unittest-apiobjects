class ApiObjectsTest < Test::Unit::TestCase
  def test_same
    assert_equal(ApiObjects.same(1, 'b'), false, 'Number is not string')
    assert_equal(ApiObjects.same({ 'b' => 1 }, 'b'), false, 'Hash is not string')
    assert_equal(ApiObjects.same(1, { 'b' => 1 }), false, 'Number is not Hash')
    assert_equal(ApiObjects.same(1, 1), true, 'Equal numbers')
    a = { a: 5, b: [ 1, 2 ] }
    b = { a: 5, b: 'b' }
    assert_equal(ApiObjects.same(a, b), false, 'Different types')
    b = { a: 5, b: [ 1 ] }
    assert_equal(ApiObjects.same(a, b), false, 'Different lengths')
    b = { a: 5, b: [ 1, 2 ], c: 'c' }
    assert_equal(ApiObjects.same(a, b), false, 'Different keys')
    b = { a: 5, b: [ 1, 2 ] }
    assert_equal(ApiObjects.same(a, b), true, 'Same contents')
    b = { a: 5, b: [ 1, 2 ], 'summary' => 'foo' }
    assert_equal(ApiObjects.same(a, b), true, 'Same contents ignoring summary')
    b = { a: 5, b: [ 1, 2 ], 'description' => 'foo' }
    assert_equal(ApiObjects.same(a, b), true, 'Same contents ignoring description')
    b = { a: 5, b: [ 1, 2 ], 'summary' => 'foo', 'description' => 'bar' }
    assert_equal(ApiObjects.same(a, b), true, 'Same contents ignoring description and summary')
  end

  def test_reference
    a = { a: 5, b: [ 1, 2 ] }
    b = { a: 5, b: 'b' }
    s = { 'bref' => b }
    path = 'testing'
    r = ApiObjects.reference(a, s, path)
    assert_equal(s.size, 2, 'New name added')
    r = ApiObjects.reference(a.merge({ 'summary' => 'foo' }), s, path)
    r2 = ApiObjects.reference(a, s, path)
    assert_equal(r, r2, 'Same object yields same reference')
    assert_equal(s.size, 2, 'No new name added')
    r = ApiObjects.reference(b, s, path)
    assert_equal(s.size, 2, 'No new name added either')
    s = { 'bref' => b }
    prefix = 'Prefix'
    path = 'testing'
    r = ApiObjects.reference(b, s, 'testing', Set.new(%w[summary description]), prefix)
    assert_equal(s.size, 1, 'No new name added with prefix')
    r = ApiObjects.reference(a, s, 'testing', Set.new(%w[summary description]), prefix)
    assert_equal(s.size, 2, 'New reference added with prefix')
    assert_equal(r.start_with?("#{path}/#{prefix}"), true, 'Reference starts with prefix')
  end

  def test_components_reference
    path = 'testing'
    prefix = 'Prefix'
    cmp = ApiObjects::Components.new(path, prefix)
    a = { a: 5, b: [ 1, 2 ] }
    b = { a: 5, b: 'b' }
    cmp.items['bref'] = b
    r = cmp.reference(a)
    s = cmp.items
    assert_equal(s.size, 2, 'New name added')
    r = cmp.reference(a.merge({ 'summary' => 'foo' }))
    r2 = cmp.reference(a)
    assert_equal(r, r2, 'Same object yields same reference')
    assert_equal(s.size, 2, 'No new name added')
    r = cmp.reference(b)
    assert_equal(s.size, 2, 'No new name added either')
    cmp = ApiObjects::Components.new(path, prefix)
    cmp.items['bref'] = b
    r = cmp.reference(b)
    s = cmp.items
    assert_equal(s.size, 1, 'No new name added with prefix')
    r = cmp.reference(a)
    assert_equal(s.size, 2, 'New reference added with prefix')
    assert_equal(r.start_with?("#{path}/#{prefix}"), true, 'Reference starts with prefix')
  end

  def test_components_to_reference_object
    path = 'testing'
    prefix = 'Prefix'
    cmp = ApiObjects::Components.new(path, prefix, %w[ignore])
    a = { a: 5, b: [ 1, 2 ] }
    assert_equal(cmp.to_reference_object(a).object_id, a.object_id, 'Same returned')
    assert_equal(a.key?('$ref'), true, 'Reference key')
    assert_equal(a.size, 1, 'No retained keys')
    assert_equal(cmp.items.size, 1, 'New name added')
    cmp.retain_ignored = true
    b = { a: 5, b: [ 1, 2 ], 'ignore' => 'value' }
    assert_equal(cmp.to_reference_object(b).object_id, b.object_id, 'Same returned')
    assert_equal(b.key?('$ref'), true, 'Reference key')
    assert_equal(b.key?('ignore'), true, 'ignored key')
    assert_equal(b.size, 2, 'No other retained keys')
    assert_equal(a['$ref'], b['$ref'], 'Same reference')
    assert_equal(cmp.items.size, 1, 'No new name added')
  end

  def test_components_add_schema_name
    path = 'testing'
    prefix = 'Prefix'
    cmp = ApiObjects::Components.new(path, prefix)
    cmp.add_schema_name('name')
    assert_equal(cmp.schema_names.member?('name'), true, 'Schema name in set')
    assert_equal(cmp.schema_names.member?('sdohfg'), false, 'Schema name not in set')
  end

  def test_components_store_anchor
    path = 'testing'
    prefix = 'Prefix'
    cmp = ApiObjects::Components.new(path, prefix)
    cmp.store_anchor({})
    assert_equal(cmp.anchor2ref.empty?, true, 'Not anchor, not added')
    obj = { '$anchor' => 'name' }
    cmp.store_anchor(obj, 'ref')
    assert_equal(cmp.anchor2ref[obj['$anchor']], 'ref', 'name mapped to given ref')
    begin
      cmp.store_anchor(obj)
      assert_equal(true, false, 'Exception not raised')
    rescue Exception
      assert_equal(true, true, 'Exception raised')
    end
    obj = { '$anchor' => 'name2', '$ref' => 'ref2' }
    cmp.store_anchor(obj)
    assert_equal(cmp.anchor2ref[obj['$anchor']], obj['$ref'], 'name2 mapped to obj ref')
  end

  def test_components_alter_anchors
    path = 'testing'
    prefix = 'Prefix'
    cmp = ApiObjects::Components.new(path, prefix)
    cmp.add_schema_name('existing')
    cmp.store_anchor({ '$anchor' => 'name' }, 'ref')
    cmp.store_anchor({ '$anchor' => 'existing' }, 'ref2')
    assert_equal(cmp.anchor2ref.size, 2, 'size 2')
    assert_equal(cmp.anchor2ref['name'], 'ref', 'name to ref')
    assert_equal(cmp.anchor2ref['existing'], 'ref2', 'existing to ref2')
    cmp.alter_anchors
    assert_equal(cmp.anchor2ref.size, 2, 'size unchanged')
    assert_equal(cmp.anchor2ref['name'], cmp.ref_string('name'), 'name to ref string')
    assert_equal(cmp.anchor2ref['existing'], 'ref2', 'existing unchanged')
  end

  def test_components_anchor_ref_replacement
    path = 'testing'
    prefix = 'Prefix'
    cmp = ApiObjects::Components.new(path, prefix)
    cmp.add_schema_name('existing')
    cmp.store_anchor({ '$anchor' => 'name' }, 'ref')
    cmp.store_anchor({ '$anchor' => 'existing' }, 'ref2')
    cmp.alter_anchors
    assert_equal(cmp.anchor_ref_replacement('#other'), '#other', 'absent not changed')
    assert_equal(cmp.anchor_ref_replacement('#name'), cmp.ref_string('name'), 'name found')
    assert_equal(cmp.anchor_ref_replacement('#existing'), 'ref2', 'existing found')
  end

