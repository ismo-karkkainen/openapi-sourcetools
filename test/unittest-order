class ArrayItemCompareTest < Test::Unit::TestCase
  def test_equal_values
    a = { values: [1, 2, 3] }
    b = { values: [1, 2, 3] }
    assert_equal(0, Ordering.array_item_compare(a, b), 'identical values')
  end

  def test_less_than
    a = { values: [1, 2, 3] }
    b = { values: [1, 3, 3] }
    assert_equal(-1, Ordering.array_item_compare(a, b), 'a < b at index 1')
  end

  def test_greater_than
    a = { values: [1, 4, 3] }
    b = { values: [1, 2, 3] }
    assert_equal(1, Ordering.array_item_compare(a, b), 'a > b at index 1')
  end

  def test_nil_a_non_nil_b
    a = { values: [nil, 2] }
    b = { values: [1, 2] }
    assert_equal(1, Ordering.array_item_compare(a, b), 'nil a pushes to end')
  end

  def test_non_nil_a_nil_b
    a = { values: [1, 2] }
    b = { values: [nil, 2] }
    assert_equal(-1, Ordering.array_item_compare(a, b), 'nil b pushes to end')
  end

  def test_both_nil
    a = { values: [nil, 2] }
    b = { values: [nil, 3] }
    assert_equal(-1, Ordering.array_item_compare(a, b), 'both nil, compare next')
  end

  def test_string_values
    a = { values: ['apple', 'banana'] }
    b = { values: ['apple', 'cherry'] }
    assert_equal(-1, Ordering.array_item_compare(a, b), 'string comparison')
  end

  def test_empty_values
    a = { values: [] }
    b = { values: [] }
    assert_equal(0, Ordering.array_item_compare(a, b), 'empty arrays equal')
  end

  def test_single_value
    a = { values: [5] }
    b = { values: [3] }
    assert_equal(1, Ordering.array_item_compare(a, b), 'single value comparison')
  end
end

class KeyPatternTest < Test::Unit::TestCase
  def test_initialize
    pat = Regexp.new('^foo$')
    kp = Ordering::KeyPattern.new(pat, 0, 0)
    assert_equal(pat, kp.pattern, 'pattern stored')
    assert_equal(0, kp.index, 'index stored')
    assert_equal(0, kp.priority, 'priority stored')
  end

  def test_match_succeeds
    kp = Ordering::KeyPattern.new(Regexp.new('^foo$'), 0, 0)
    assert_true(kp.match?('foo'), 'matches foo')
  end

  def test_match_fails
    kp = Ordering::KeyPattern.new(Regexp.new('^foo$'), 0, 0)
    assert_false(kp.match?('bar'), 'does not match bar')
  end

  def test_any_false_when_index_equals_priority
    kp = Ordering::KeyPattern.new(Regexp.new('x'), 3, 3)
    assert_false(kp.any?, 'not any when index == priority')
  end

  def test_any_true_when_index_differs_from_priority
    kp = Ordering::KeyPattern.new(Regexp.new('x'), 1, 5)
    assert_equal(true, kp.any?, 'any when index != priority')
  end
end

class KeyPathInitializeTest < Test::Unit::TestCase
  def test_plain_strings
    kp = Ordering::KeyPath.new(%w[foo bar], 're:')
    assert_equal(2, kp.items.size, 'two items')
    assert_true(kp.items[0].match?('foo'), 'first matches foo')
    assert_false(kp.items[0].match?('baz'), 'first rejects baz')
    assert_true(kp.items[1].match?('bar'), 'second matches bar')
    assert_false(kp.multiple, 'no multiple')
    assert_equal(2, kp.first_multiple, 'first_multiple at end')
  end

  def test_single_star_becomes_any
    kp = Ordering::KeyPath.new(%w[foo * bar], 're:')
    assert_equal(3, kp.items.size, 'three items')
    assert_true(kp.items[1].match?('anything'), '* matches anything')
    assert_false(kp.multiple, 'no multiple')
  end

  def test_double_star_becomes_multi
    kp = Ordering::KeyPath.new(%w[foo ** bar], 're:')
    assert_equal(3, kp.items.size, 'three items')
    assert_equal(:multi, kp.items[1], '** becomes :multi')
    assert_equal(true, kp.multiple, 'has multiple')
    assert_equal(1, kp.first_multiple, 'first_multiple at index 1')
  end

  def test_regexp_prefix
    kp = Ordering::KeyPath.new(['re:^a.*z$'], 're:')
    assert_equal(1, kp.items.size, 'one item')
    assert_true(kp.items[0].match?('abcz'), 'regexp matches')
    assert_false(kp.items[0].match?('bz'), 'regexp rejects')
  end

  def test_star_after_multi_reorders
    kp = Ordering::KeyPath.new(%w[** *], 're:')
    assert_equal(2, kp.items.size, 'two items')
    assert_equal(Ordering::ANY, kp.items[0], 'first is ANY (from :one)')
    assert_equal(:multi, kp.items[1], 'second is :multi')
  end

  def test_multi_after_multi_reorders
    kp = Ordering::KeyPath.new(%w[** **], 're:')
    assert_equal(2, kp.items.size, 'two items')
    assert_equal(Ordering::ANY, kp.items[0], 'first is ANY (from :one)')
    assert_equal(:multi, kp.items[1], 'second is :multi')
  end

  def test_special_characters_escaped
    kp = Ordering::KeyPath.new(['foo.bar'], 're:')
    assert_false(kp.items[0].match?('fooXbar'), 'dot is escaped')
    assert_true(kp.items[0].match?('foo.bar'), 'literal dot matches')
  end
end

class KeyPathMatchTest < Test::Unit::TestCase
  def test_exact_match_two_keys
    kp = Ordering::KeyPath.new(%w[foo bar], 're:')
    assert_equal(true, kp.match?(%w[foo bar]), 'exact match')
  end

  def test_exact_match_rejects_wrong_key
    kp = Ordering::KeyPath.new(%w[foo bar], 're:')
    assert_false(kp.match?(%w[foo baz]), 'wrong last key')
    assert_false(kp.match?(%w[baz bar]), 'wrong first key')
  end

  def test_path_too_short
    kp = Ordering::KeyPath.new(%w[foo bar baz], 're:')
    assert_false(kp.match?(%w[foo]), 'too short')
  end

  def test_path_too_long_without_multiple
    kp = Ordering::KeyPath.new(%w[foo bar], 're:')
    assert_false(kp.match?(%w[foo x bar]), 'too long no multiple')
  end

  def test_wildcard_match
    kp = Ordering::KeyPath.new(%w[foo * bar], 're:')
    assert_equal(true, kp.match?(%w[foo anything bar]), 'wildcard matches')
    assert_false(kp.match?(%w[foo anything else bar]), 'wildcard too long')
  end

  def test_multi_match_one_extra
    kp = Ordering::KeyPath.new(%w[foo ** bar], 're:')
    assert_equal(true, kp.match?(%w[foo x bar]), 'multi matches one')
  end

  def test_multi_match_several_extra
    kp = Ordering::KeyPath.new(%w[foo ** bar], 're:')
    assert_equal(true, kp.match?(%w[foo a b c bar]), 'multi matches several')
  end

  def test_multi_at_start
    kp = Ordering::KeyPath.new(%w[** bar], 're:')
    assert_equal(true, kp.match?(%w[anything bar]), 'multi at start one key')
    assert_equal(true, kp.match?(%w[a b bar]), 'multi at start two keys')
  end

  def test_multi_at_end
    kp = Ordering::KeyPath.new(%w[foo **], 're:')
    assert_equal(true, kp.match?(%w[foo anything]), 'multi at end one key')
    assert_equal(true, kp.match?(%w[foo a b]), 'multi at end two keys')
  end

  def test_three_items_exact
    kp = Ordering::KeyPath.new(%w[a b c], 're:')
    assert_equal(true, kp.match?(%w[a b c]), 'three exact')
    assert_false(kp.match?(%w[a x c]), 'middle mismatch')
  end

  def test_regexp_in_path
    kp = Ordering::KeyPath.new(['re:^f', 'bar'], 're:')
    assert_equal(true, kp.match?(%w[foo bar]), 'regexp prefix match')
    assert_false(kp.match?(%w[goo bar]), 'regexp prefix reject')
  end

  def test_single_item_path
    kp = Ordering::KeyPath.new(%w[foo], 're:')
    assert_false(kp.match?(%w[foo bar]), 'single pattern two keys')
    assert_false(kp.match?([]), 'empty path')
  end

  def test_empty_items_empty_path
    kp = Ordering::KeyPath.new([], 're:')
    assert_equal(true, kp.match?([]), 'both empty matches')
    assert_false(kp.match?(%w[foo]), 'empty items rejects non-empty path')
  end
end

class KeyPathCompareTest < Test::Unit::TestCase
  def test_shorter_is_less
    a = Ordering::KeyPath.new(%w[a b], 're:')
    b = Ordering::KeyPath.new(%w[a b c], 're:')
    assert_equal(-1, a <=> b, 'shorter < longer')
    assert_equal(1, b <=> a, 'longer > shorter')
  end

  def test_same_length_more_multi_is_less
    a = Ordering::KeyPath.new(%w[** b], 're:')
    b = Ordering::KeyPath.new(%w[a b], 're:')
    assert_equal(-1, a <=> b, 'more multi comes first')
    assert_equal(1, b <=> a, 'less multi comes later')
  end

  def test_equal
    a = Ordering::KeyPath.new(%w[a b], 're:')
    b = Ordering::KeyPath.new(%w[x y], 're:')
    assert_equal(0, a <=> b, 'same size same multi count')
  end
end

class KeyPathMatchingItemIndexesTest < Test::Unit::TestCase
  def test_skip_non_multis
    kp = Ordering::KeyPath.new(%w[a * ** d], 're:')
    idxs = kp.matching_item_indexes('a', 0)
    assert(idxs.include?(0), 'index 0 matches a')
    idxs2 = kp.matching_item_indexes('x', 2)
    assert(idxs2.include?(2), ':multi matches anything')
  end

  def test_multi_always_matches
    kp = Ordering::KeyPath.new(%w[** foo], 're:')
    idxs = kp.matching_item_indexes('anything', 0)
    assert(idxs.include?(0), ':multi matches any key')
  end
end

