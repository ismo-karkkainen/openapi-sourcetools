class OrderInitializeTest < Test::Unit::TestCase
  def test_plain_keys
    o = Ordering::Order.new(%w[alpha beta], 're:')
    assert_equal(3, o.patterns.size, 'two keys + catch-all')
    assert_true(o.patterns[0].match?('alpha'), 'first matches alpha')
    assert_true(o.patterns[1].match?('beta'), 'second matches beta')
    assert_true(o.patterns[2].match?('gamma'), 'catch-all matches anything')
  end

  def test_with_asterisk
    o = Ordering::Order.new(%w[alpha * beta], 're:')
    assert_equal(3, o.patterns.size, 'three patterns, no extra catch-all')
    assert_equal(true, o.patterns[1].any?, 'asterisk pattern is any')
  end

  def test_duplicate_asterisk_uses_first
    o = Ordering::Order.new(%w[alpha * beta *], 're:')
    assert_equal(3, o.patterns.size, 'duplicate * ignored')
  end

  def test_regexp_prefix_key
    o = Ordering::Order.new(['re:^x.*$', 'foo'], 're:')
    assert_equal(3, o.patterns.size, 'regexp + plain + catch-all')
    assert_true(o.patterns[0].match?('xyz'), 'regexp pattern matches')
    assert_false(o.patterns[0].match?('abc'), 'regexp pattern rejects')
  end

  def test_no_asterisk_adds_catchall
    o = Ordering::Order.new(%w[a b], 're:')
    last = o.patterns.last
    assert_equal(true, last.any?, 'catch-all is any')
    assert_true(last.match?('whatever'), 'catch-all matches')
  end
end

class OrderApplyHashTest < Test::Unit::TestCase
  def test_basic_ordering
    o = Ordering::Order.new(%w[b a], 're:')
    h = { 'a' => 1, 'b' => 2, 'c' => 3 }
    result = o.apply_hash(h)
    assert_equal(true, result, 'returns true')
    assert_equal(%w[b a c], h.keys, 'keys ordered: b first, a second, c in catch-all')
  end

  def test_with_number
    o = Ordering::Order.new(%w[b a], 're:')
    h = { 'a' => 1, 'b' => 2, 5 => 3 }
    result = o.apply_hash(h)
    assert_equal(true, result, 'returns true')
    assert_equal(['b', 'a', 5], h.keys, 'keys ordered: b first, a second, 5 in catch-all')
  end

  def test_with_number_in_order
    o = Ordering::Order.new(%w[b 5 a], 're:')
    h = { 'a' => 1, 'b' => 2, 5 => 3 }
    result = o.apply_hash(h)
    assert_equal(true, result, 'returns true')
    assert_equal(['b', 5, 'a'], h.keys, 'keys ordered: b first, 5 second, a third')
  end

  def test_unknown_keys_sorted_alphabetically
    o = Ordering::Order.new(%w[z], 're:')
    h = { 'c' => 3, 'a' => 1, 'b' => 2, 'z' => 26 }
    o.apply_hash(h)
    assert_equal(%w[z a b c], h.keys, 'z first, rest sorted')
  end

  def test_empty_hash
    o = Ordering::Order.new(%w[a], 're:')
    h = {}
    result = o.apply_hash(h)
    assert_equal(true, result, 'returns true for empty')
    assert_equal({}, h, 'still empty')
  end

  def test_all_matching_keys
    o = Ordering::Order.new(%w[c b a], 're:')
    h = { 'a' => 1, 'b' => 2, 'c' => 3 }
    o.apply_hash(h)
    assert_equal(%w[c b a], h.keys, 'all keys reordered')
  end

  def test_regexp_pattern_ordering
    o = Ordering::Order.new(['re:^x', 'a'], 're:')
    h = { 'a' => 1, 'xb' => 2, 'xa' => 3, 'z' => 4 }
    o.apply_hash(h)
    assert_equal('xa', h.keys[0], 'regexp group first, sorted')
    assert_equal('xb', h.keys[1], 'regexp group second')
    assert_equal('a', h.keys[2], 'exact match next')
  end

  def test_values_preserved
    o = Ordering::Order.new(%w[b a], 're:')
    h = { 'a' => 'alpha', 'b' => 'beta' }
    o.apply_hash(h)
    assert_equal('beta', h['b'], 'value preserved')
    assert_equal('alpha', h['a'], 'value preserved')
  end
end

class OrderApplyArrayTest < Test::Unit::TestCase
  def test_sort_by_first_key
    o = Ordering::Order.new(%w[name], 're:')
    arr = [
      { 'name' => 'charlie' },
      { 'name' => 'alice' },
      { 'name' => 'bob' }
    ]
    result = o.apply_array(arr)
    assert_equal(true, result, 'returns true')
    assert_equal('alice', arr[0]['name'], 'sorted first')
    assert_equal('bob', arr[1]['name'], 'sorted second')
    assert_equal('charlie', arr[2]['name'], 'sorted third')
  end

  def test_sort_by_multiple_keys
    o = Ordering::Order.new(%w[group name], 're:')
    arr = [
      { 'group' => 'b', 'name' => 'alice' },
      { 'group' => 'a', 'name' => 'bob' },
      { 'group' => 'a', 'name' => 'alice' }
    ]
    o.apply_array(arr)
    assert_equal('a', arr[0]['group'], 'group a first')
    assert_equal('alice', arr[0]['name'], 'alice in group a')
    assert_equal('a', arr[1]['group'], 'group a second')
    assert_equal('bob', arr[1]['name'], 'bob in group a')
    assert_equal('b', arr[2]['group'], 'group b last')
  end

  def test_non_hash_items_preserved
    o = Ordering::Order.new(%w[name], 're:')
    arr = [
      { 'name' => 'bob' },
      'string_item',
      { 'name' => 'alice' }
    ]
    o.apply_array(arr)
    assert_equal('alice', arr[0]['name'], 'alice sorted first')
    assert_equal('bob', arr[1]['name'], 'bob sorted second')
    assert_equal('string_item', arr[2], 'non-hash at end (nil values)')
  end

  def test_hash_and_array_values_treated_as_nil
    o = Ordering::Order.new(%w[val], 're:')
    arr = [
      { 'val' => [1, 2] },
      { 'val' => 'alpha' },
      { 'val' => { 'k' => 'v' } }
    ]
    o.apply_array(arr)
    assert_equal('alpha', arr[0]['val'], 'string value sorts first')
  end

  def test_empty_array
    o = Ordering::Order.new(%w[x], 're:')
    arr = []
    result = o.apply_array(arr)
    assert_equal(true, result, 'returns true')
    assert_equal([], arr, 'still empty')
  end

  def test_single_element
    o = Ordering::Order.new(%w[x], 're:')
    arr = [{ 'x' => 1 }]
    o.apply_array(arr)
    assert_equal(1, arr[0]['x'], 'single element unchanged')
  end
end

class OrderApplyTest < Test::Unit::TestCase
  def test_apply_dispatches_to_hash
    o = Ordering::Order.new(%w[b a], 're:')
    h = { 'a' => 1, 'b' => 2 }
    result = o.apply(h)
    assert_equal(true, result, 'hash returns true')
    assert_equal(%w[b a], h.keys, 'hash ordered')
  end

  def test_apply_dispatches_to_array
    o = Ordering::Order.new(%w[name], 're:')
    arr = [{ 'name' => 'b' }, { 'name' => 'a' }]
    result = o.apply(arr)
    assert_equal(true, result, 'array returns true')
    assert_equal('a', arr[0]['name'], 'array sorted')
  end

  def test_apply_returns_false_for_other
    o = Ordering::Order.new(%w[a], 're:')
    assert_false(o.apply('string'), 'string returns false')
    assert_false(o.apply(42), 'number returns false')
    assert_false(o.apply(nil), 'nil returns false')
  end
end

class KeyPathOrderTest < Test::Unit::TestCase
  def test_initialize
    path = Ordering::KeyPath.new(%w[a b], 're:')
    order = Ordering::Order.new(%w[x], 're:')
    kpo = Ordering::KeyPathOrder.new(path, order)
    assert_equal(path, kpo.path, 'path stored')
    assert_equal(order, kpo.order, 'order stored')
  end

  def test_comparison_delegates_to_path
    p1 = Ordering::KeyPath.new(%w[a b], 're:')
    p2 = Ordering::KeyPath.new(%w[a b c], 're:')
    o = Ordering::Order.new(%w[x], 're:')
    kpo1 = Ordering::KeyPathOrder.new(p1, o)
    kpo2 = Ordering::KeyPathOrder.new(p2, o)
    assert_equal(-1, kpo1 <=> kpo2, 'shorter path is less')
    assert_equal(1, kpo2 <=> kpo1, 'longer path is greater')
  end

  def test_equal_paths
    p1 = Ordering::KeyPath.new(%w[a b], 're:')
    p2 = Ordering::KeyPath.new(%w[x y], 're:')
    o = Ordering::Order.new(%w[x], 're:')
    kpo1 = Ordering::KeyPathOrder.new(p1, o)
    kpo2 = Ordering::KeyPathOrder.new(p2, o)
    assert_equal(0, kpo1 <=> kpo2, 'same size paths are equal')
  end
end

